# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase compatibility
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_BASE_URL=
BRIGHTDATA_POLL_INTERVAL_MS=
BRIGHTDATA_POLL_TIMEOUT_MS=
BRIGHTDATA_OPENAI_COLLECTOR_ID=
OPENAI_PRICING_SOURCE_URL=
BRIGHTDATA_ANTHROPIC_COLLECTOR_ID=
ANTHROPIC_PRICING_SOURCE_URL=
BRIGHTDATA_ANTHROPIC_LIFECYCLE_COLLECTOR_ID=
ANTHROPIC_LIFECYCLE_SOURCE_URL=
BRIGHTDATA_GEMINI_COLLECTOR_ID=
GEMINI_PRICING_SOURCE_URL=
BRIGHTDATA_GEMINI_LIFECYCLE_COLLECTOR_ID=
GEMINI_LIFECYCLE_SOURCE_URL=
BRIGHTDATA_XAI_COLLECTOR_ID=
XAI_PRICING_SOURCE_URL=

# AI Radar
AI_RADAR_INGEST_SECRET=

# Collection orchestration (Vercel Cron)
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/collect.
CRON_SECRET=
# Fleet-wide defaults; every one is overridable per source.
AI_RADAR_COLLECTION_CADENCE_MINUTES=
AI_RADAR_COLLECTION_TIMEOUT_MS=
AI_RADAR_COLLECTION_MAX_ATTEMPTS=
AI_RADAR_COLLECTION_BACKOFF_MS=
AI_RADAR_COLLECTION_MAX_BACKOFF_MS=
# Per-source overrides, e.g. AI_RADAR_SOURCE_OPENAI_PRICING_CADENCE_MINUTES=360
# Suffixes: _ENABLED, _CADENCE_MINUTES, _TIMEOUT_MS, _MAX_ATTEMPTS
# Keys: OPENAI_PRICING, ANTHROPIC_PRICING, GEMINI_PRICING, XAI_PRICING,
#       ANTHROPIC_LIFECYCLE, GEMINI_LIFECYCLE
