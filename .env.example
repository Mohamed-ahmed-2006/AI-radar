# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy Supabase compatibility
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_BASE_URL=
BRIGHTDATA_POLL_INTERVAL_MS=
BRIGHTDATA_POLL_TIMEOUT_MS=
BRIGHTDATA_OPENAI_COLLECTOR_ID=
OPENAI_PRICING_SOURCE_URL=
BRIGHTDATA_ANTHROPIC_COLLECTOR_ID=
ANTHROPIC_PRICING_SOURCE_URL=
BRIGHTDATA_ANTHROPIC_LIFECYCLE_COLLECTOR_ID=
ANTHROPIC_LIFECYCLE_SOURCE_URL=
BRIGHTDATA_GEMINI_COLLECTOR_ID=
GEMINI_PRICING_SOURCE_URL=
BRIGHTDATA_GEMINI_LIFECYCLE_COLLECTOR_ID=
GEMINI_LIFECYCLE_SOURCE_URL=
BRIGHTDATA_XAI_COLLECTOR_ID=
XAI_PRICING_SOURCE_URL=
BRIGHTDATA_OPENAI_CATALOG_COLLECTOR_ID=
OPENAI_CATALOG_SOURCE_URL=
BRIGHTDATA_ANTHROPIC_CATALOG_COLLECTOR_ID=
ANTHROPIC_CATALOG_SOURCE_URL=
BRIGHTDATA_GEMINI_CATALOG_COLLECTOR_ID=
GEMINI_CATALOG_SOURCE_URL=
BRIGHTDATA_XAI_CATALOG_COLLECTOR_ID=
XAI_CATALOG_SOURCE_URL=

# AI Radar
AI_RADAR_INGEST_SECRET=

# Operator credential for browser-driven operator controls.
# Exchanged once at POST /api/operator/session for a signed HttpOnly cookie that
# unlocks the healing-demo actions for one hour in that browser. The credential
# itself never reaches client code. Falls back to CRON_SECRET /
# AI_RADAR_INGEST_SECRET when unset; set it separately so demo access can be
# rotated without touching the scheduler.
AI_RADAR_OPERATOR_KEY=

# Collection orchestration (Vercel Cron)
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/collect.
CRON_SECRET=
# Fleet-wide defaults; every one is overridable per source.
AI_RADAR_COLLECTION_CADENCE_MINUTES=
AI_RADAR_COLLECTION_TIMEOUT_MS=
AI_RADAR_COLLECTION_MAX_ATTEMPTS=
AI_RADAR_COLLECTION_BACKOFF_MS=
AI_RADAR_COLLECTION_MAX_BACKOFF_MS=
# Per-source overrides, e.g. AI_RADAR_SOURCE_OPENAI_PRICING_CADENCE_MINUTES=360
# Suffixes: _ENABLED, _CADENCE_MINUTES, _TIMEOUT_MS, _MAX_ATTEMPTS
# Keys: OPENAI_PRICING, ANTHROPIC_PRICING, GEMINI_PRICING, XAI_PRICING,
#       ANTHROPIC_LIFECYCLE, GEMINI_LIFECYCLE,
#       OPENAI_CATALOG, ANTHROPIC_CATALOG, GEMINI_CATALOG, XAI_CATALOG

# Sentinel source-health UI
# Set to 1 for local development/demo recordings only. Makes /source-health run
# the deterministic in-memory hero simulation instead of reading live Sentinel
# telemetry. Absent or any other value always shows live data, or a loading /
# error / empty state when live data cannot be read.
SENTINEL_DEMO_MODE=

# Fabricated temporal-evidence corpus.
# Leave UNSET in production. `?demo=true` on the intelligence and Ask surfaces
# is honoured only when this is exactly `1`; otherwise those surfaces read live
# evidence or report emptiness. Requesting demo data is never sufficient on its
# own — see lib/intelligence/demo-gate.ts.
AI_RADAR_DEMO_EVIDENCE=

# ---------------------------------------------------------------------------
# Sentinel self-healing demonstration (dedicated demo source only)
# ---------------------------------------------------------------------------
# The demo runs against its OWN Bright Data collector and its own `sources` row.
# It never targets a pricing, lifecycle or catalog collector: with this unset
# the harness refuses to run rather than falling back to a production one.
BRIGHTDATA_DEMO_COLLECTOR_ID=
# Optional. When set, both demo layouts are served by this deployment, at
# <base>/demo-source/healthy and <base>/demo-source/broken. This is the
# preferred mechanism — the controlled incompatibility is then a page we own.
AI_RADAR_DEMO_SOURCE_BASE_URL=
# Fallback targets used only when AI_RADAR_DEMO_SOURCE_BASE_URL is unset.
# Defaults are the public quotes.toscrape.com scraping sandbox.
AI_RADAR_DEMO_HEALTHY_URL=
AI_RADAR_DEMO_BROKEN_URL=
# Demo actions are authorized with the operator credential: the
# AI_RADAR_OPERATOR_KEY / CRON_SECRET / AI_RADAR_INGEST_SECRET header, or the
# signed session cookie a browser gets from POST /api/operator/session.
#
# Leave UNSET in production. Opens the mutating healing-demo actions to any
# anonymous caller. It is NOT required for a public deployment — the operator
# session is the supported mechanism — and exists only for a throwaway
# deployment where anyone may press the buttons. Expensive steps stay rate
# limited even when it is set.
AI_RADAR_HEALING_DEMO_OPEN_CONTROLS=

# Verify this file against the deployment before shipping:
#   npm run check:env
